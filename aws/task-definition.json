{
  "family": "brightpath-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::$AWS_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::$AWS_ACCOUNT_ID:role/brightpathApiTaskRole",
  "containerDefinitions": [
    {
      "name": "brightpath-api",
      "image": "$AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/brightpath-api:latest",
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {"name": "SPRING_DATASOURCE_URL", "value": "jdbc:postgresql://$RDS_ENDPOINT:5432/brightpath"},
        {"name": "SPRING_DATASOURCE_USERNAME", "value": "$DB_USERNAME"},
        {"name": "SPRING_DATASOURCE_PASSWORD", "value": "$DB_PASSWORD"},
        {"name": "SPRING_DATA_REDIS_HOST", "value": "$REDIS_ENDPOINT"},
        {"name": "SPRING_DATA_REDIS_PORT", "value": "6379"},
        {"name": "JWT_SECRET", "value": "$JWT_SECRET"},
        {"name": "SERVER_PORT", "value": "8080"}
      ],
      "secrets": [
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:$AWS_DEFAULT_REGION:$AWS_ACCOUNT_ID:secret:brightpath/db-password"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:$AWS_DEFAULT_REGION:$AWS_ACCOUNT_ID:secret:brightpath/jwt-secret"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/brightpath-api",
          "awslogs-region": "$AWS_DEFAULT_REGION",
          "awslogs-stream-prefix": "brightpath-api"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8080/actuator/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
